# Render → benim-meram-api servisi → Environment bölümüne bu değerleri girin.
# (Bilgisayarda çalıştırırken bu dosyanın kopyasını ".env" adıyla oluşturun.)

# Render'daki PostgreSQL veritabanının adresi.
# Aynı bölgedeki (Virginia) servis için "Internal Database URL"i kullanın.
DATABASE_URL=

# Giriş anahtarlarını imzalamak için uzun, rastgele bir metin. Kimseyle paylaşmayın.
# Render'da "Generate" düğmesiyle üretebilirsiniz.
JWT_SECRET=

# İsteğe bağlı
# PORT=4000
# DATABASE_POOL_MAX=10
# SMS_PROVIDER=none
